{
  "name": "@event-horizon/attestation-workspace",
  "version": "0.4.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@event-horizon/attestation-workspace",
      "version": "0.4.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.8.0"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "apps/service": {
      "name": "@event-horizon/attestation-service",
      "version": "0.4.0",
      "dependencies": {
        "@event-horizon/attestation-core": "0.4.0"
      }
    },
    "node_modules/@event-horizon/attestation-cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@event-horizon/attestation-core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@event-horizon/attestation-crypto": {
      "resolved": "packages/crypto",
      "link": true
    },
    "node_modules/@event-horizon/attestation-middleware": {
      "resolved": "packages/middleware",
      "link": true
    },
    "node_modules/@event-horizon/attestation-sdk": {
      "resolved": "packages/sdk",
      "link": true
    },
    "node_modules/@event-horizon/attestation-service": {
      "resolved": "apps/service",
      "link": true
    },
    "node_modules/@event-horizon/attestation-simulator": {
      "resolved": "packages/simulator",
      "link": true
    },
    "node_modules/@event-horizon/attestation-tpm": {
      "resolved": "packages/tpm",
      "link": true
    },
    "node_modules/@types/node": {
      "version": "22.20.1",
      "dev": true,
      "license": "MIT",
      "dependencies": {
        "undici-types": "~6.21.0"
      }
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "node_modules/undici-types": {
      "version": "6.21.0",
      "dev": true,
      "license": "MIT"
    },
    "packages/cli": {
      "name": "@event-horizon/attestation-cli",
      "version": "0.4.0",
      "dependencies": {
        "@event-horizon/attestation-sdk": "0.4.0",
        "@event-horizon/attestation-simulator": "0.4.0"
      },
      "bin": {
        "eh-attest": "dist/index.js"
      }
    },
    "packages/core": {
      "name": "@event-horizon/attestation-core",
      "version": "0.4.0",
      "dependencies": {
        "@event-horizon/attestation-crypto": "0.4.0"
      }
    },
    "packages/crypto": {
      "name": "@event-horizon/attestation-crypto",
      "version": "0.4.0"
    },
    "packages/middleware": {
      "name": "@event-horizon/attestation-middleware",
      "version": "0.4.0",
      "dependencies": {
        "@event-horizon/attestation-sdk": "0.4.0"
      }
    },
    "packages/sdk": {
      "name": "@event-horizon/attestation-sdk",
      "version": "0.4.0",
      "dependencies": {
        "@event-horizon/attestation-core": "0.4.0",
        "@event-horizon/attestation-simulator": "0.4.0",
        "@event-horizon/attestation-tpm": "0.4.0"
      }
    },
    "packages/simulator": {
      "name": "@event-horizon/attestation-simulator",
      "version": "0.4.0",
      "dependencies": {
        "@event-horizon/attestation-core": "0.4.0",
        "@event-horizon/attestation-crypto": "0.4.0"
      }
    },
    "packages/tpm": {
      "name": "@event-horizon/attestation-tpm",
      "version": "0.4.0",
      "dependencies": {
        "@event-horizon/attestation-core": "0.4.0"
      }
    }
  }
}
