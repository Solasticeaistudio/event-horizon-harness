{
  "boot-source": {
    "kernel_image_path": "KERNEL_IMAGE",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off random.trust_cpu=on init=/init"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "ROOTFS_IMAGE",
      "is_root_device": true,
      "is_read_only": true
    },
    {
      "drive_id": "scratch",
      "path_on_host": "EPHEMERAL_SCRATCH_IMAGE",
      "is_root_device": false,
      "is_read_only": false
    }
  ],
  "machine-config": {
    "vcpu_count": 1,
    "mem_size_mib": 128,
    "smt": false,
    "track_dirty_pages": false
  },
  "vsock": {
    "guest_cid": 52,
    "uds_path": "VSOCK_UDS"
  }
}
